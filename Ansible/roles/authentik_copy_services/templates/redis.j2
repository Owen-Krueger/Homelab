[Unit]
Description=Authentik
Wants=network-online.target
After=network-online.target

[Container]
Image={{ authentik_redis_image }}
ContainerName=redis
Exec=--save 60 1 --loglevel warning
Volume=/home/owen/authentik/redis:/data:Z
HealthCmd=CMD-SHELL redis-cli ping | grep PONG
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=20s
HealthTimeout=3s
Network=authentik.network

[Service]
Restart=always

[Install]
WantedBy=default.target
